# Copy to .env and fill in real values. Never commit .env with real values.

# The SAME Supabase project SimSim's own apps use (publishable/anon key —
# never the service_role key; this agent authenticates as a real staff
# account, RLS-scoped by has_restaurant_access/member_has_branch_access,
# exactly like any human staff member using the Dashboard).
SUPABASE_URL=https://gpwwnuuicywsvmmhxngs.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# A dedicated staff account created by the restaurant owner via the
# existing Staff management page in the Dashboard (src/pages/Staff.jsx) —
# give it a distinct username like "print-agent" so it's clearly not a
# person. This agent needs no dashboard "allowed_pages" at all; it never
# opens the Dashboard UI, only calls RPCs.
PRINT_AGENT_EMAIL=
PRINT_AGENT_PASSWORD=

RESTAURANT_ID=
BRANCH_ID=

# Base URL the agent fetches print documents from (same origin the browser
# print view already uses) — https://simsimmenu.com in production.
MENU_BASE_URL=https://simsimmenu.com

# How often to poll for pending jobs, in milliseconds.
POLL_INTERVAL_MS=5000

# Stale-claim recovery window (seconds) and max retry attempts — mirrors
# claim_next_print_job's own defaults; override here only if you have a
# specific reason to.
STALE_AFTER_SECONDS=120
MAX_ATTEMPTS=5

# Network thermal printer connection (ESC/POS raw stream, typically port
# 9100). Leave PRINTER_HOST unset to run with the mock adapter (logs what
# would have been sent instead of opening a real socket) — useful for
# dry-running the agent without real hardware.
PRINTER_HOST=
PRINTER_PORT=9100
