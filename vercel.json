{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "www.simsimmenu.com" }
      ],
      "status": 308,
      "headers": { "Location": "https://simsimmenu.com/$1" }
    },
    {
      "src": "/(menu)/(.+)",
      "dest": "https://simsim-menu-next.vercel.app/menu/$2"
    },
    {
      "src": "/api/(customer/.+)",
      "dest": "https://simsim-menu-next.vercel.app/api/$1"
    },
    {
      "src": "/(login|register|forgot-password|reset-password|verify-email|auth/callback|onboarding|dashboard|orders|customers|branches|tables|qr|settings|analytics|billing|loyalty|marketing|staff|admin|logrocket-diag)$",
      "dest": "/index.html"
    },
    {
      "src": "/(staff-login|admin)/(.+)",
      "dest": "/index.html"
    },
    {
      "src": "/menu$",
      "dest": "/index.html"
    },
    {
      "src": "/$",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/"
    },
    {
      "src": "/en$",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/en"
    },
    {
      "src": "/en/(.*)",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/en/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/_next/$1"
    },
    {
      "src": "/(sitemap.xml|robots.txt|favicon.svg|og-image.svg|simsim-s.svg)$",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/$1"
    },
    {
      "src": "/(preview|api/revalidate)$",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/$1"
    },
    {
      "src": "/([^./]+)$",
      "dest": "https://simsim-marketing-ssr-staging.vercel.app/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.logrocket.io https://cdn.logr-in.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://r.lr-ingest.io https://r.logr-in.com; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
